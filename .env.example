# Local Supabase values: obtain from `supabase status` after starting the stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted application origin for OAuth redirects; HTTPS in production.
APP_URL=http://127.0.0.1:3000

# Local Google provider setup; configure supabase/config.toml before enabling.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Reserved for approved administrative modules; never import in user request paths.
SUPABASE_SERVICE_ROLE_KEY=

# Not needed for the scaffold. Phase 2 enables paid API calls separately.
OPENAI_API_KEY=
